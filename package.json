{
  "name": "quintessential-latin",
  "version": "0.250.0",
  "private": true,
  "description": "Quintessential Latin repertoire, reference font, code charts, and UCSUR proposal",
  "author": "Josh Hufford",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/export_glyph_catalogue.js --check && npm run build:unifont && node tools/build_site.mjs",
    "dev": "node tools/serve_site.mjs",
    "test": "node tools/test_logical_allocation.js && node tools/test_canonical_glyph_names.js && node tools/test_unifont.mjs && node tools/test_site.mjs",
    "test:browser": "node tools/test_browser.mjs",
    "build:pdf": "python tools/build_pdfs.py",
    "test:pdf": "python tools/test_pdfs.py",
    "build:font": "python tools/build_quintessential_font.py",
    "test:font": "python tools/test_fonts.py",
    "test:preservation": "python tools/test_additions_font.py",
    "build:unifont": "node tools/build_unifont_glyphs.mjs",
    "build:unifont:font": "npm run build:unifont && node tools/run_unifont_font.mjs build",
    "test:unifont:font": "node tools/run_unifont_font.mjs test",
    "test:unifont:font:browser": "node tools/test_unifont_font_browser.mjs",
    "test:unifont": "node tools/test_unifont.mjs",
    "test:unifont:sources": "node resources/unifont/construct_middle_branches.mjs --check && python -X utf8 resources/unifont/generate_middle_shared_spines.py --check && node resources/unifont/generate-double-middle-shared-spines.mjs --check",
    "test:unifont:review": "node tools/test_unifont.mjs --reviewed",
    "test:unifont:browser": "node tools/test_unifont_browser.mjs",
    "preview:unifont": "npm run build:unifont && node tools/build_site.mjs --unifont-only"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
